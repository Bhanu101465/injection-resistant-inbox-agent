# LLM Provider switcher: "mock" (fake model) or "nebius" (real model)
LLM_PROVIDER=mock

# Nebius Token Factory settings
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT=30.0

# NVIDIA / LLM provider settings
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
JUDGE_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
TEMPERATURE=0
ENABLE_REASONING=false

# Agent settings
MAX_AGENT_ITERATIONS=10
AUDIT_LOG_PATH=audit.jsonl
LLM_CACHE_PATH=llm_cache.db
